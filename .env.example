# r2-d6 - variáveis de ambiente (valores de DESENVOLVIMENTO). Copie para .env (o `npm run dev` faz isso sozinho).
# Nada aqui é segredo de produção; em produção use o cofre do provedor.

DATABASE_URL=postgres://r2d6:r2d6@127.0.0.1:5432/r2d6
DATABASE_URL_TEST=postgres://r2d6:r2d6@127.0.0.1:5432/r2d6_test
APP_URL=http://localhost:5173
PORT=3000
BETTER_AUTH_SECRET=dev-only-change-me-dev-only-change-me
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="r2-d6 <no-reply@r2d6.local>"

# Mídia (retratos): local = pasta .data/media
STORAGE_DRIVER=local
MEDIA_DIR=.data/media

# Contas de demonstração (seed): mestre@r2d6.local e jogador@r2d6.local usam esta senha. Só no dev.
SEED_PASSWORD=r2d6-demo-2026

# Login social: vazio = botão escondido (exige criar os apps OAuth)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Holocron (assistente de regras com IA): vazio = desligado ("em breve" na UI)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_DAILY_LIMIT=40
